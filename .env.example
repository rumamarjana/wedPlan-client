# Public Next.js application URLs
# Local development values. On Vercel these are optional: the auth client uses
# the page origin at runtime and the server falls back to VERCEL_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Better Auth
# Leave BETTER_AUTH_URL as localhost for local development. On Vercel either
# set it to the deployed client origin or omit it (VERCEL_URL is used).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_DB_URL=mongodb+srv://<user>:<password>@<cluster>/wedplandb
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Comma-separated list of extra client origins allowed to call /api/auth.
# Add the Vercel client origin here when it is not covered by VERCEL_URL.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# OAuth and image hosting
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
NEXT_PUBLIC_IMGBB_API_KEY=replace-me
